<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="TARge25.ValgusfoorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Valgusfoor"
    BackgroundColor="#F3F3F3">

    <Grid>

        <!-- Põhisisu -->
        <VerticalStackLayout
            Padding="20"
            Spacing="25"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <!-- Pealkiri -->
            <Label
                x:Name="StatusLabel"
                Text="Vali valgus"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="Black"
                HorizontalTextAlignment="Center"
                HorizontalOptions="Center" />

            <!-- Valgusfoori korpus -->
            <Border
                x:Name="TrafficLightBody"
                BackgroundColor="#202020"
                Padding="20"
                Stroke="#505050"
                StrokeThickness="2"
                HorizontalOptions="Center">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="30" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="15">

                    <!-- Punane -->
                    <Border
                        x:Name="RedLight"
                        WidthRequest="100"
                        HeightRequest="100"
                        BackgroundColor="Gray"
                        Stroke="#707070"
                        StrokeThickness="2"
                        HorizontalOptions="Center">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="50" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRedTapped" />
                        </Border.GestureRecognizers>

                    </Border>

                    <!-- Kollane -->
                    <Border
                        x:Name="YellowLight"
                        WidthRequest="100"
                        HeightRequest="100"
                        BackgroundColor="Gray"
                        Stroke="#707070"
                        StrokeThickness="2"
                        HorizontalOptions="Center">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="50" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnYellowTapped" />
                        </Border.GestureRecognizers>

                    </Border>

                    <!-- Roheline -->
                    <Border
                        x:Name="GreenLight"
                        WidthRequest="100"
                        HeightRequest="100"
                        BackgroundColor="Gray"
                        Stroke="#707070"
                        StrokeThickness="2"
                        HorizontalOptions="Center">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="50" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGreenTapped" />
                        </Border.GestureRecognizers>

                    </Border>

                </VerticalStackLayout>

            </Border>

            <!-- Sisse / Välja -->
            <HorizontalStackLayout
                Spacing="15"
                HorizontalOptions="Center">

                <Button
                    Text="SISSE"
                    WidthRequest="120"
                    HeightRequest="50"
                    Clicked="OnTurnOnClicked" />

                <Button
                    Text="VÄLJA"
                    WidthRequest="120"
                    HeightRequest="50"
                    Clicked="OnTurnOffClicked" />

            </HorizontalStackLayout>

            <!-- Öörežiim -->
            <Button
                x:Name="NightModeButton"
                Text="ÖÖREŽIIM"
                WidthRequest="255"
                HeightRequest="50"
                Clicked="OnNightModeClicked" />

        </VerticalStackLayout>

        <!-- Tume kiht öörežiimi jaoks -->
        <BoxView
            x:Name="NightOverlay"
            BackgroundColor="Black"
            Opacity="0"
            InputTransparent="True" />

    </Grid>

</ContentPage>