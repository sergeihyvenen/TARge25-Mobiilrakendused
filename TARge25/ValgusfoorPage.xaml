<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="TARge25.ValgusfoorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Valgusfoor"
    BackgroundColor="#F2F4F7">

    <ScrollView>

        <VerticalStackLayout
            Padding="24"
            Spacing="18">


            <!-- PEALKIRI -->

            <Label
                Text="Valgusfoor"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#1F2937"
                HorizontalTextAlignment="Center" />


            <!-- STAATUS -->

            <Border
                BackgroundColor="White"
                Stroke="#D7DDE5"
                StrokeThickness="1"
                Padding="14">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <Label
                    x:Name="StatusLabel"
                    Text="Vali valgus"
                    FontSize="21"
                    FontAttributes="Bold"
                    TextColor="#1F2937"
                    HorizontalTextAlignment="Center" />

            </Border>


            <!-- ============================================ -->
            <!-- VALGUSFOOR -->
            <!-- ============================================ -->

            <Grid
                HorizontalOptions="Center"
                Margin="0,5">


                <!-- FOORI KORPUS -->

                <Border
                    WidthRequest="180"
                    HeightRequest="390"
                    BackgroundColor="#25282D"
                    Stroke="#111318"
                    StrokeThickness="4">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="35" />
                    </Border.StrokeShape>

                </Border>


                <!-- TULED -->

                <VerticalStackLayout
                    Spacing="20"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">


                    <!-- PUNANE -->

                    <BoxView
                        x:Name="RedLight"
                        WidthRequest="100"
                        HeightRequest="100"
                        CornerRadius="50"
                        Color="Gray"
                        InputTransparent="True">

                        <BoxView.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="OnRedTapped" />

                        </BoxView.GestureRecognizers>

                    </BoxView>


                    <!-- KOLLANE -->

                    <BoxView
                        x:Name="YellowLight"
                        WidthRequest="100"
                        HeightRequest="100"
                        CornerRadius="50"
                        Color="Gray"
                        InputTransparent="True">

                        <BoxView.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="OnYellowTapped" />

                        </BoxView.GestureRecognizers>

                    </BoxView>


                    <!-- ROHELINE -->

                    <BoxView
                        x:Name="GreenLight"
                        WidthRequest="100"
                        HeightRequest="100"
                        CornerRadius="50"
                        Color="Gray"
                        InputTransparent="True">

                        <BoxView.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="OnGreenTapped" />

                        </BoxView.GestureRecognizers>

                    </BoxView>

                </VerticalStackLayout>

            </Grid>


            <!-- ============================================ -->
            <!-- SISSE / VÄLJA -->
            <!-- ============================================ -->

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="12">

                <Button
                    Grid.Column="0"
                    Text="SISSE"
                    HeightRequest="55"
                    CornerRadius="15"
                    FontAttributes="Bold"
                    FontSize="17"
                    BackgroundColor="#2E7D32"
                    TextColor="White"
                    Clicked="OnTurnOnClicked" />


                <Button
                    Grid.Column="1"
                    Text="VÄLJA"
                    HeightRequest="55"
                    CornerRadius="15"
                    FontAttributes="Bold"
                    FontSize="17"
                    BackgroundColor="#C62828"
                    TextColor="White"
                    Clicked="OnTurnOffClicked" />

            </Grid>


            <!-- ============================================ -->
            <!-- LISATEGEVUSED -->
            <!-- ============================================ -->

            <Border
                BackgroundColor="White"
                Stroke="#D7DDE5"
                StrokeThickness="1"
                Padding="16">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>


                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Lisategevused"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#263238" />


                    <!-- ÖÖREŽIIM -->

                    <Button
                        x:Name="NightModeButton"
                        Text="ÖÖREŽIIM"
                        HeightRequest="50"
                        CornerRadius="14"
                        FontAttributes="Bold"
                        BackgroundColor="#3949AB"
                        TextColor="White"
                        Clicked="OnNightModeClicked" />


                    <!-- AUTOMAATREŽIIM -->

                    <Button
                        x:Name="AutoModeButton"
                        Text="AUTOMAATREŽIIM"
                        HeightRequest="50"
                        CornerRadius="14"
                        FontAttributes="Bold"
                        BackgroundColor="#0277BD"
                        TextColor="White"
                        Clicked="OnAutoModeClicked" />


                    <Label
                        Text="Automaatrežiimis vahetub tuli iga 2 sekundi järel."
                        FontSize="12"
                        TextColor="#78909C"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>